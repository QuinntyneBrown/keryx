# Format and code style for the backend. `dotnet format --verify-no-changes` reads this in CI,
# and the build enforces the analysers (Directory.Build.props).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,yml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Written by `dotnet ef migrations add`; never edited by hand.
[**/Migrations/*.cs]
generated_code = true
