@startuml
title UML sequence behaviour — Retry failed sources: another run is in progress
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Keryx Admin application" #E0F2FE
  participant "RunsPage" as page
  participant "RunsStore" as store
  participant "HttpRunsApi" as client
  participant "Notifier" as notifier
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminRunsController" as controller
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "RetryFailedSourcesCommandHandler" as handler
  participant "Run" as run
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box

actor -> page : Press "Retry failed sources"
page -> store : retryFailedSources()
store -> client : retryFailedSources(id)
client -> controller : POST /admin/v1/runs/{id}/retry
controller -> handler : Send RetryFailedSourcesCommand
handler -> db : Load run and RunLease
alt run id unknown or malformed
  handler --> controller : throw RunNotFoundException
  controller --> client : 404 ProblemDetails code run_not_found
else lease names another active run
  handler --> controller : throw RunInProgressException(running id)
  controller --> client : 409 ProblemDetails code run_in_progress (L2-059)
  client --> store : ApiError run_in_progress
  store -> notifier : Notification: a collection is already running
end
store --> page : Button enabled again
@enduml
