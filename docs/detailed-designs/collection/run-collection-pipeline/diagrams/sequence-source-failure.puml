@startuml
title UML sequence behaviour — Run the collection pipeline: a source throws and a source times out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx Worker application" #D1FADF
  participant "CollectionScheduler" as scheduler
  participant "CollectionPipeline" as pipeline
  participant "FetchStage" as fetch
  participant "Parse / Classify / Deduplicate" as middle
  participant "StoreStage" as store
  participant "PublishStage" as publish
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "RunCollectionCommandHandler" as handler
  participant "Run" as run
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "HttpSourceFetcher" as fetcher
  database "Keryx database" as db
end box
participant "Sources" as sources

participant "FakeTimeProvider" as clock
pipeline -> fetch : Start
par source A throws
  fetch -> fetcher : FetchAsync(source A)
  fetcher --> fetch : exception
  fetch -> fetch : Record source A failed with its reason (L2-008 isolation)
  fetch -> handler : Report source failure
  handler -> run : Add issue on source A; sources_failed + 1
else source B times out
  loop attempt 1 to 3 (L2-008 up to 3 in total)
    fetch -> fetcher : FetchAsync(source B) with 30 s time-out from Settings
    clock -> fetch : Time-out fires at 30 s; call cancelled (L2-008 abandon at 30 s)
    fetch -> clock : Wait FetchRetryPolicy.DelayBefore(next attempt), increasing
  end
  fetch -> handler : Report source B failed only after the last attempt
  handler -> run : Add source_timeout issue on source B
else other sources answer
  fetch -> fetcher : FetchAsync(source C)
  fetcher -> sources : GET
  sources --> fetcher : 200
  fetch -> middle : Stream source C's items
end
middle -> store : Items of the sources that answered
store -> db : Batches
pipeline -> publish : Publish
publish -> db : One transaction
pipeline --> handler : fetch done_with_warnings (sources_ok 62, sources_failed 2)
handler -> run : Finish: outcome completed_with_issues
handler -> db : Save run; release RunLease
@enduml
