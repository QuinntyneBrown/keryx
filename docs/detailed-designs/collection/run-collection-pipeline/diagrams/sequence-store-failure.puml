@startuml
title UML sequence behaviour — Run the collection pipeline: the store stage cannot reach the database
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx Worker application" #D1FADF
  participant "CollectionScheduler" as scheduler
  participant "CollectionPipeline" as pipeline
  participant "FetchStage" as fetch
  participant "Parse / Classify / Deduplicate" as middle
  participant "StoreStage" as store
  participant "PublishStage" as publish
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "RunCollectionCommandHandler" as handler
  participant "Run" as run
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "HttpSourceFetcher" as fetcher
  database "Keryx database" as db
end box
participant "Sources" as sources

pipeline -> fetch : Start
fetch -> middle : Stream items
middle -> store : Stream matched items
store -> db : Insert StagedRecord batch
db --> store : connection failure
store --> pipeline : StageResult failed
pipeline -> pipeline : Cancel the remaining stages; publish not started
pipeline --> handler : PipelineResult: store failed, publish not_run
handler -> run : FailStage(store, generic reason); later stages stay not_run (L2-007)
handler -> run : Finish: outcome failed
handler -> db : Save run, discard the run's staged records, release RunLease
note over db : Live tables untouched; the API serves exactly what it served before the run (L2-007)
handler --> scheduler : RunCollectionResult failed
@enduml
