@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Read events

Container_Boundary(api_b, "Keryx API") {
  Component(ctrl, "EventsController", "ASP.NET Core controller", "Exposes /v1/events and /v1/events/{id}")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(lh, "ListEventsQueryHandler", "MediatR handler", "Filters by range, region and org and pages")
  Component(gh, "GetEventQueryHandler", "MediatR handler", "Reads one served event")
  Component(spec, "ServedEvents", "Query specification", "Restricts a query to events the API serves")
  Component(pager, "CursorPager", "Application service", "Seeks by start time and id")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")
System_Ext(client, "Consuming product", "Christian Fitness and other products that publish Keryx records")

Rel(client, ctrl, "GET /v1/events", "JSON/HTTPS")
Rel(ctrl, lh, "Sends ListEventsQuery")
Rel(ctrl, gh, "Sends GetEventQuery")
Rel(lh, spec, "Starts from")
Rel(gh, spec, "Starts from")
Rel(lh, pager, "Pages with")
Rel(lh, ctx, "Reads through IAppDbContext")
Rel(gh, ctx, "Reads through IAppDbContext")
Rel(ctx, db, "Reads", "EF Core")
@enduml
