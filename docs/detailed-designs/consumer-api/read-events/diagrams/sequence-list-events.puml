@startuml
title UML sequence behaviour — List upcoming events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx API application" #D1FADF
  participant "EventsController" as ctrl
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "ListEventsQueryHandler" as lh
  participant "CursorPager" as pager
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
participant "Consuming product" as client
client -> ctrl : GET /v1/events?region=toronto
ctrl -> ctrl : API key, scope events:read, rate limit
ctrl -> lh : Send ListEventsQuery
lh -> lh : Validate range: to after from, at most 366 days
alt invalid range or filter
  lh --> ctrl : invalid_filter
  ctrl --> client : 400 ProblemDetails
else valid
  lh -> pager : PageAsync(ServedEvents from now, limit, cursor)
  pager -> db : Seek by (starts_at, id) ascending
  db --> pager : Rows
  pager --> lh : CursorPage
  lh --> ctrl : Page of EventDto
  ctrl --> client : 200 data, next_cursor
end
@enduml
