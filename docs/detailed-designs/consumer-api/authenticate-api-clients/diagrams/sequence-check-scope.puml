@startuml
title UML sequence behaviour — Check the endpoint's scope
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Consuming product" as product
box "Backend — Keryx API application" #D1FADF
  participant "ScopeAuthorizationHandler" as scopes
  participant "ApiAuthorizationResultHandler" as result
  participant "EventsController" as controller
  participant "ProblemDetailsMapper" as mapper
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "ListEventsQueryHandler" as query
end box
product -> scopes : GET /v1/events with authenticated principal
scopes -> scopes : Endpoint policy events:read; compare with scope claims (L2-034)
alt principal holds events:read
  scopes --> controller : Requirement met
  controller -> query : Send ListEventsQuery
  query --> controller : Page of events
  controller --> product : 200 OK
else principal lacks events:read
  scopes --> result : Requirement failed
  result -> mapper : InsufficientScopeException(events:read)
  mapper --> product : 403 insufficient_scope, required_scope = events:read
end
note over product, scopes
  /v1/categories, /v1/regions and /v1/status use the api-client policy:
  any authenticated client meets it, whatever its scopes (L2-034).
end note
@enduml
