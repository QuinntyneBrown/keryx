@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Create an API key

Person(staff, "Staff member", "Signed-in person who passes the staff policy")
Container_Boundary(admin_b, "Keryx admin application") {
  Component(page, "ApiPage", "Angular routed component", "Shows the one-time callout and the consumers table")
  Component(dlg, "NewApiKeyDialog", "Angular CDK Dialog component", "Collects the product name and the scopes")
  Component(store, "ApiClientsStore", "Angular signal store", "Holds the clients page and the revealed key")
  Component(svc, "HttpApiClientsService", "Angular service", "Implements the ApiClientsService contract")
}
Container_Boundary(api_b, "Keryx API") {
  Component(ctrl, "AdminApiClientsController", "ASP.NET Core controller", "Exposes POST /admin/v1/api-clients")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(h, "CreateApiClientCommandHandler", "MediatR handler", "Generates the key and stores its hash and prefix")
  Component(gen, "ApiKeyGenerator", "Domain service", "Builds a key from a cryptographic generator")
  Component(hash, "ApiKeyHasher", "Domain service", "Hashes the key with SHA-256")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")

Rel(staff, page, "Presses New API key")
Rel(page, dlg, "Opens")
Rel(dlg, svc, "Submits through")
Rel(dlg, store, "Returns the created key to")
Rel(page, store, "Reads the revealed key from")
Rel(svc, ctrl, "POST /admin/v1/api-clients", "JSON/HTTPS")
Rel(ctrl, h, "Sends CreateApiClientCommand")
Rel(h, gen, "Generates key with")
Rel(h, hash, "Hashes key with")
Rel(h, ctx, "Persists through IAppDbContext")
Rel(ctx, db, "Writes hash and prefix", "EF Core")
@enduml
