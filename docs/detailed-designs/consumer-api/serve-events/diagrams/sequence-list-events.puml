@startuml
title UML sequence behaviour — List events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Consuming product" as product
box "Backend — Keryx API application" #D1FADF
  participant "ApiKeyAuthenticationHandler" as auth
  participant "EventsController" as controller
  participant "EtagFilter" as etag
  participant "ProblemDetailsMapper" as mapper
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "ListEventsQueryValidator" as validator
  participant "ListEventsQueryHandler" as handler
  participant "ServedRecordFilters" as served
  participant "TimeProvider" as clock
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "DataProtectionCursorCodec" as codec
  participant "KeryxDbContext" as ctx
  database "Keryx database" as db
end box
product -> auth : GET /v1/events?from=…&to=…&region=toronto&limit=…
auth -> auth : Authenticate Bearer key and apply events:read policy
alt key lacks events:read
  auth --> product : 403 problem+json, code insufficient_scope
else authorized
  auth -> controller : Authenticated client
  controller -> validator : Send ListEventsQuery
  validator -> validator : Apply L2-026 limit bound and cursor check
  validator -> validator : Apply L2-028 range rule (to not before from, at most 366 days)
  validator -> ctx : Region slug exists
  ctx --> validator : Known or unknown
  alt invalid limit, filter or cursor
    validator --> mapper : InvalidLimit, InvalidFilter or InvalidCursor exception
    mapper --> product : 400 problem+json, code invalid_limit, invalid_filter or invalid_cursor
  else valid
    validator -> handler : Valid ListEventsQuery
    handler -> clock : GetUtcNow()
    clock --> handler : now
    handler -> served : Apply L2-016 served rule (linked article published, or own status published)
    served --> handler : Filtered query
    handler -> ctx : starts_at >= max(now, from) and < to; region; org; seek after (starts_at, id) asc; take limit + 1
    ctx -> db : One keyset query projecting event columns
    db --> ctx : Up to limit + 1 rows
    ctx --> handler : EventDto rows
    opt more rows remain
      handler -> codec : Encode last (starts_at, id) and filter fingerprint
      codec --> handler : next_cursor
    end
    handler --> controller : PageDto (data, next_cursor)
    controller --> etag : 200 result
    etag -> etag : Apply L2-032 ETag and Cache-Control
    etag --> product : 200 JSON page
  end
end
@enduml
