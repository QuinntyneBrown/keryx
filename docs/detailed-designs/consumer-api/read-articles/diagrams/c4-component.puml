@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Read published articles

Container_Boundary(api_b, "Keryx API") {
  Component(ctrl, "ArticlesController", "ASP.NET Core controller", "Exposes /v1/articles and /v1/articles/{id}")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(lh, "ListArticlesQueryHandler", "MediatR handler", "Filters, orders and pages published articles")
  Component(gh, "GetArticleQueryHandler", "MediatR handler", "Reads one published article")
  Component(val, "ListArticlesQueryValidator", "FluentValidation validator", "Checks region, category, org, since, limit and cursor")
  Component(spec, "ServedArticles", "Query specification", "Restricts a query to articles the API serves")
  Component(pager, "CursorPager", "Application service", "Seeks by published time and id")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")
System_Ext(client, "Consuming product", "Christian Fitness and other products that publish Keryx records")

Rel(client, ctrl, "GET /v1/articles", "JSON/HTTPS")
Rel(ctrl, lh, "Sends ListArticlesQuery")
Rel(ctrl, gh, "Sends GetArticleQuery")
Rel(lh, val, "Is validated by")
Rel(lh, spec, "Starts from")
Rel(gh, spec, "Starts from")
Rel(lh, pager, "Pages with")
Rel(lh, ctx, "Reads through IAppDbContext")
Rel(gh, ctx, "Reads through IAppDbContext")
Rel(ctx, db, "Reads", "EF Core")
@enduml
