@startuml
title UML sequence behaviour — List published articles
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx API application" #D1FADF
  participant "ArticlesController" as ctrl
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "ListArticlesQueryHandler" as lh
  participant "CursorPager" as pager
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
participant "Consuming product" as client
client -> ctrl : GET /v1/articles?region=toronto&limit=10
ctrl -> ctrl : API key, scope articles:read, rate limit
ctrl -> lh : Send ListArticlesQuery
lh -> lh : Validate filters, limit and cursor
alt invalid
  lh --> ctrl : invalid_filter, invalid_limit or invalid_cursor
  ctrl --> client : 400 ProblemDetails
else valid
  lh -> pager : PageAsync(ServedArticles filtered, limit, cursor)
  pager -> db : Seek by (published_at, id) descending, take limit + 1
  db --> pager : Rows
  pager --> lh : CursorPage
  lh --> ctrl : Page of ArticleSummaryDto
  ctrl --> client : 200 data, next_cursor, ETag
end
@enduml
