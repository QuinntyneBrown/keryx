@startuml
title UML sequence behaviour — List organizations
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Consuming product" as product
box "Backend — Keryx API application" #D1FADF
  participant "ApiKeyAuthenticationHandler" as auth
  participant "OrganizationsController" as controller
  participant "EtagFilter" as etag
  participant "ProblemDetailsMapper" as mapper
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "ListOrganizationsQueryValidator" as validator
  participant "ListOrganizationsQueryHandler" as handler
  participant "ServedRecordFilters" as served
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "DataProtectionCursorCodec" as codec
  participant "KeryxDbContext" as ctx
  database "Keryx database" as db
end box
product -> auth : GET /v1/organizations?region=toronto&kind=church&q=gr
auth -> auth : Authenticate Bearer key and apply sources:read policy
auth -> controller : Authenticated client
controller -> validator : Send ListOrganizationsQuery
validator -> validator : Apply L2-026 limit and cursor rules; L2-029 q is 2 to 60 characters; kind from fixed list
validator -> codec : Decode cursor
codec --> validator : CursorPosition or refused
alt invalid limit, filter or cursor
  validator --> mapper : KeryxException with code
  mapper --> product : 400 problem+json, code invalid_limit, invalid_filter or invalid_cursor
else valid
  validator -> handler : Valid ListOrganizationsQuery
  handler -> served : Apply L2-029 listed rule (at least one served article or event)
  served --> handler : Filtered query
  handler -> ctx : region, kind, normalized name prefix q; seek after (name, id) asc; take limit + 1; article_count as grouped subquery
  ctx -> db : One query, counts of served articles only
  db --> ctx : Up to limit + 1 rows
  ctx --> handler : OrganizationDto rows
  opt more rows remain
    handler -> codec : Encode last (name, id)
    codec --> handler : next_cursor
  end
  handler --> controller : PageDto
  controller --> etag : 200 result
  etag --> product : 200 JSON page with ETag
end
@enduml
