@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Revoke an API key

Person(staff, "Staff member", "Signed-in person who passes the staff policy")
System_Boundary(keryx, "Keryx") {
  Container(admin, "Keryx admin application", "Angular", "Staff-only admin UI")
  Container(api, "Keryx API", "ASP.NET Core", "Consumer API under /v1 and admin endpoints under /admin/v1")
  ContainerDb(db, "Keryx database", "Relational database, EF Core", "Records, provenance, runs, settings and API clients")
}
System_Ext(client, "Consuming product", "Christian Fitness and other products that publish Keryx records")

Rel(staff, admin, "Uses", "HTTPS")
Rel(admin, api, "Calls /admin/v1", "JSON/HTTPS")
Rel(client, api, "Calls /v1 with an API key", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
