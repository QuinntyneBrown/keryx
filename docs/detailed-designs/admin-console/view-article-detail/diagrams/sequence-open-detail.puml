@startuml
title UML sequence behaviour — Open an article's detail
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as staff
box "Frontend — Keryx admin application" #E0F2FE
  participant "ArticlesPage" as page
  participant "ArticleDetail" as panel
  participant "HttpArticlesService" as svc
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminArticlesController" as ctrl
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "GetAdminArticleQueryHandler" as h
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
staff -> page : Activate a row (click, tap or Enter)
page -> page : Write ?article=art_18429; remember the row for focus
page -> panel : @defer loads the panel on first use
panel -> svc : get(id)
svc -> ctrl : GET /admin/v1/articles/art_18429
ctrl -> h : Send GetAdminArticleQuery
h -> db : Article with provenance
alt found
  db --> h : Article
  h --> ctrl : AdminArticleDetailDto
  ctrl --> svc : 200
  svc --> panel : Detail
  panel -> panel : Bind text; safeHttpUrl(url); actions for status
  panel --> staff : Detail panel with "Publish" and "Hide from API"
else unknown id
  h --> ctrl : article_not_found (404)
  ctrl --> svc : ProblemDetails
  page --> staff : List only; notification says the article could not be found
end
staff -> panel : Press Escape
panel --> page : closed
page --> staff : Focus returns to the row
@enduml
