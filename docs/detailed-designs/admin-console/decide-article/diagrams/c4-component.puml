@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Publish, hide and undo an article decision

Person(staff, "Staff member", "Signed-in person who passes the staff policy")
Container_Boundary(admin_b, "Keryx admin application") {
  Component(panel, "ArticleDetail", "Angular deferred component", "Emits publish and hide from its action buttons")
  Component(store, "ArticlesStore", "Angular signal store", "Sends one decision at a time and refreshes counts")
  Component(ns, "NotificationStore", "Angular signal store, application-wide", "Shows the outcome with Undo or Try again")
  Component(svc, "HttpArticlesService", "Angular service", "Calls publish, hide and revert")
}
Container_Boundary(api_b, "Keryx API") {
  Component(ctrl, "AdminArticlesController", "ASP.NET Core controller", "Exposes POST …/publish, …/hide and …/revert")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(h, "DecideArticleCommandHandler", "MediatR handler", "Applies a staff decision or a revert")
  Component(a, "Article", "Domain entity", "Owns the status transitions")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")

Rel(staff, panel, "Presses Publish or Hide from API")
Rel(panel, store, "Emits the action to")
Rel(store, svc, "Decides through")
Rel(store, ns, "Reports outcome to")
Rel(svc, ctrl, "POST /admin/v1/articles/{id}/publish", "JSON/HTTPS")
Rel(ctrl, h, "Sends DecideArticleCommand")
Rel(h, a, "Loads and mutates")
Rel(h, ctx, "Persists through IAppDbContext")
Rel(ctx, db, "Reads and writes", "EF Core")
@enduml
