@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse, search and filter articles

Person(staff, "Staff member", "Signed-in person who passes the staff policy")
Container_Boundary(admin_b, "Keryx admin application") {
  Component(page, "ArticlesPage", "Angular routed component", "Composes tabs, search, selects, table and pagination")
  Component(store, "ArticlesStore", "Angular signal store", "Derives list state from the URL and holds one page")
  Component(svc, "HttpArticlesService", "Angular service", "Implements the ArticlesService contract")
}
Container_Boundary(lib_b, "Frontend libraries (components, domain, api)") {
  Component(qb, "buildArticlesQuery", "Pure function, domain library", "Maps list state to URL and request parameters")
  Component(lib, "tab, input, select, table, badge, pagination, skeleton, empty", "Components library", "Presentation components named as in the design system")
}
Container_Boundary(api_b, "Keryx API") {
  Component(ctrl, "AdminArticlesController", "ASP.NET Core controller", "Exposes GET /admin/v1/articles")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(h, "ListAdminArticlesQueryHandler", "MediatR handler", "Filters, searches, counts and pages")
  Component(val, "ListAdminArticlesQueryValidator", "FluentValidation validator", "Bounds page, page_size and q")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")

Rel(staff, page, "Opens Articles")
Rel(page, store, "Reads signals from")
Rel(page, lib, "Composes")
Rel(store, qb, "Builds the query with")
Rel(store, svc, "Loads through")
Rel(svc, ctrl, "GET /admin/v1/articles", "JSON/HTTPS")
Rel(ctrl, h, "Sends ListAdminArticlesQuery")
Rel(h, val, "Is validated by")
Rel(h, ctx, "Reads through")
Rel(ctx, db, "Reads", "EF Core")
@enduml
