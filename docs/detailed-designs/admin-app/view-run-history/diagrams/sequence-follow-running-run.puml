@startuml
title UML sequence behaviour — Follow a running run
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Keryx Admin application" #E0F2FE
  participant "RunsPage" as page
  participant "RunsStore" as store
  participant "DestroyRef" as destroy
  participant "HttpRunsApi" as client
  participant "CollectionWatcher" as watcher
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminRunsController" as controller
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "GetRunQueryHandler" as geth
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
actor -> page : Open Runs while run_2419 is in progress
store -> client : getRun(run_2419), once, as for any run chosen
store -> watcher : observed(RunDto) — the watcher follows run_2419 (it tracked it from the list)
store -> watcher : onRead(show the chosen run), released by DestroyRef
page --> actor : run_2419 first as "Running"; "Run now" is a disabled "Collecting…" (L2-058)
loop while outcome is running, 3 s after each answer (L2-058 criterion 2)
  watcher -> client : getRun(run_2419) — the only poll of the run, on any screen
  client -> controller : GET /admin/v1/runs/run_2419
  controller -> geth : Send GetRunQuery
  geth -> db : Read run, stages and progress
  db --> geth : Run in progress
  geth --> controller : RunDto(outcome = running, sources_checked, sources_total)
  controller --> client : 200 RunDto
  client --> watcher : RunDto
  watcher -> store : onRead(RunDto); shown while run_2419 is the run chosen
  store --> page : Stages done, running or not run; counts advance
end
alt the run ends
  watcher -> watcher : No further read; active run cleared, "Run now" returns
  watcher -> page : onEnd(final RunDto)
  page -> store : refresh() reads the list again
  store --> page : Final outcome in the detail and the list
  page --> actor : Final outcome without a reload (L2-058 criterion 3)
else staff leave the screen
  actor -> page : Navigate elsewhere
  page -> destroy : Component destroyed
  destroy -> store : Release the onRead and onEnd listeners; abort the store's reads
  watcher -> watcher : Goes on following run_2419 for the shell, still every 3 s
end
@enduml
