@startuml
title UML sequence behaviour — Open a run or the articles from Overview
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Keryx Admin application" #E0F2FE
  participant "RunChart / IssueCard" as comp
  participant "OverviewPage" as page
  participant "Router" as router
  participant "RunsPage" as runs
  participant "RunsApi" as client
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminRunsController" as controller
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "GetRunQueryHandler" as handler
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
alt bar activated by pointer or keyboard
  actor -> comp : Activate bar "Today 6:00 AM: 47 new"
  comp -> page : openRun(run_2418) output
else issue card activated
  actor -> comp : Activate "Feed returned 404"
  comp -> page : Link to the run it belongs to (L2-045)
else "All runs" or more than 5 issues
  actor -> page : Activate "All runs" or the problems link
end
page -> router : Navigate in the same tab to /runs?run=run_2418 or /runs?problems=true
router -> runs : loadComponent RunsPage (L2-088)
runs -> client : getRun(run_2418)
client -> controller : GET /admin/v1/runs/run_2418
controller -> handler : Send GetRunQuery
handler -> db : Read run, stages and issues
db --> handler : Run
handler --> controller : RunDto
controller --> client : JSON
client --> runs : Typed result
runs --> actor : Runs screen with that run open
@enduml
