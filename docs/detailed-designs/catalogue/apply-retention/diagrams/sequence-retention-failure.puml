@startuml
title UML sequence behaviour — A retention run fails
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx Worker application" #D1FADF
  participant "RetentionWorker" as worker
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "ApplyRetentionCommandHandler" as handler
  participant "Run" as run
  participant "RecordRunFailureCommandHandler" as fail
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "KeryxDbContext" as ctx
  database "Keryx database" as db
end box
worker -> handler : Send ApplyRetentionCommand(schedule)
handler -> run : Start run, worker retention
handler -> ctx : Delete batch of at most 1,000
ctx -> db : Commit batch
handler -> ctx : Delete next batch
ctx --> handler : Exception
handler --> worker : Exception
worker -> fail : Send RecordRunFailureCommand(run id, correlation id)
fail -> run : Finish failed with generic reason and correlation id (L2-019)
fail -> ctx : Save run
ctx -> db : Commit (earlier batches stay deleted)
worker -> worker : Wait for next daily slot; other workers unaffected
@enduml
