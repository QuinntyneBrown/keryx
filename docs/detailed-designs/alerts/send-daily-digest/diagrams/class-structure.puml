@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Send the daily digest of held articles

class AlertDigestWorker {
  -TimeProvider clock
  #ExecuteAsync(ct: CancellationToken): Task
}
class SendDailyDigestCommand
class SendDailyDigestCommandHandler {
  +{static} int MaxTitles = 20
  +Handle(command: SendDailyDigestCommand): Task<Result>
}
class DigestContent {
  +int HeldCount
  +IReadOnlyList<string> Titles
  +string ReviewLink
}
class AlertComposer {
  +ComposeDigest(content: DigestContent): Alert
}
interface IAlertMailer {
  +SendAsync(to: string, alert: Alert, ct: CancellationToken): Task<Result>
}
AlertDigestWorker ..> SendDailyDigestCommand : sends
SendDailyDigestCommandHandler ..> SendDailyDigestCommand : handles
SendDailyDigestCommandHandler --> DigestContent : builds
SendDailyDigestCommandHandler ..> AlertComposer : uses
SendDailyDigestCommandHandler ..> IAlertMailer : uses
@enduml
