@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Audit staff actions

Container_Boundary(api_b, "Keryx API") {
  Component(hc, "HttpCurrentStaff", "ASP.NET Core service", "Reads the subject id from the session principal")
  Component(m, "AuthFailureMetrics", "OpenTelemetry meter", "Counts failed sign-in callbacks and refused requests")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(ab, "AuditBehavior", "MediatR pipeline behaviour", "Adds an audit entry when an audited command succeeds")
  Component(ia, "IAuditedCommand", "Marker interface", "Names the action and the target id of a command")
  Component(cu, "ICurrentStaff", "Application contract", "Gives the subject id of the caller")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")

Rel(ab, ia, "Reads action and target from")
Rel(ab, cu, "Reads the caller from")
Rel(hc, cu, "Implements")
Rel(ab, ctx, "Adds AuditEntry through")
Rel(ctx, db, "Writes", "EF Core")
@enduml
