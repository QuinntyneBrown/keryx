@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Emit telemetry without private data

Person(operator, "Operator", "Deploys and runs Keryx")
System_Boundary(keryx, "Keryx") {
  Container(api, "Keryx API", "ASP.NET Core", "Consumer API under /v1 and admin endpoints under /admin/v1")
  Container(worker, "Keryx Worker", ".NET hosted services", "Runs the collection, retention and alert_digest workers")
}
System_Ext(otel, "Telemetry collector", "Receives OTLP traces, metrics and logs")

Rel(api, otel, "Exports traces, metrics and logs to", "OTLP")
Rel(worker, otel, "Exports traces, metrics and logs to", "OTLP")
Rel(operator, api, "Sets the OTLP endpoint of", "configuration")
@enduml
