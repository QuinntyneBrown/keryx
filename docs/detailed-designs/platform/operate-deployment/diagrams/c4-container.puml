@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Health, migrations, seed data and configuration

Person(operator, "Operator", "Deploys and runs Keryx")
System_Boundary(keryx, "Keryx") {
  Container(api, "Keryx API", "ASP.NET Core", "Consumer API under /v1 and admin endpoints under /admin/v1")
  Container(worker, "Keryx Worker", ".NET hosted services", "Runs the collection, retention and alert_digest workers")
  Container(cli, "Keryx CLI", ".NET console", "Runs the migrate and seed commands")
  ContainerDb(db, "Keryx database", "Relational database, EF Core", "Records, provenance, runs, settings and API clients")
}

Rel(operator, cli, "Runs migrate and seed", "shell")
Rel(cli, db, "Applies migrations and seed data", "EF Core")
Rel(api, db, "Checks reachability and schema version", "EF Core")
Rel(worker, db, "Checks readiness before running", "EF Core")
Rel(operator, api, "Probes /health/live and /health/ready", "HTTPS")
@enduml
