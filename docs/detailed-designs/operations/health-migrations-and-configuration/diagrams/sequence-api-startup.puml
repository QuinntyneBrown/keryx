@startuml
title UML sequence behaviour — API startup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as op
box "Backend — Keryx API application" #D1FADF
  participant "Program" as prog
  participant "SchemaStatusLogger" as logger
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "HostRunner" as runner
  participant "Options validation" as opts
  participant "EfSchemaVersion" as schema
  database "Keryx database" as db
end box
op -> prog : Start the API
prog -> runner : RunAsync(ApiHost.Build)
runner -> opts : Validate, before the host starts
alt a required setting is missing
  opts --> runner : OptionsValidationException
  runner --> op : "Missing required setting: <name>" on standard error, never a value; exit code 2 (L2-096)
else all required settings present
  opts --> runner : Valid
  runner -> logger : Start with the host
  logger -> schema : GetAsync, once
  schema -> db : CanConnect, applied migrations
  alt schema behind the build
    schema --> logger : Behind
    logger -> logger : Log warning: run migrate (no migration applied, L2-095)
  else schema ahead of the build
    schema --> logger : Ahead
    logger -> logger : Log warning: deploy the newer build
  else database unreachable
    schema --> logger : Unreachable
    logger -> logger : Log warning: the database cannot be reached
  else schema at expected version
    schema --> logger : Ready
    logger -> logger : Log information: ready
  end
  runner --> op : Listening; /health/ready reports readiness
end
@enduml
