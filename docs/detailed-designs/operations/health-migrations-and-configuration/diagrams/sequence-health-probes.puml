@startuml
title UML sequence behaviour — Health probes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Platform probe" as probe
box "Backend — Keryx API application" #D1FADF
  participant "/health/live" as live
  participant "/health/ready" as ready
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "DatabaseReadinessCheck" as check
  participant "EfSchemaVersion" as schema
  database "Keryx database" as db
end box
probe -> live : GET /health/live (no credential)
live --> probe : 200 Healthy; no check runs, database not touched (L2-095)
probe -> ready : GET /health/ready (no credential)
ready -> check : CheckHealthAsync
check -> schema : GetAsync
schema -> db : CanConnect
alt reachable
  db --> schema : true
  schema -> db : Applied migrations
  db --> schema : Migration ids
  schema --> check : SchemaState(applied, expected)
  alt applied equals the build's expected schema version
    check --> ready : Healthy
    ready --> probe : 200 Healthy
  else behind or ahead
    check --> ready : Unhealthy
    ready --> probe : 503 Unhealthy; no version, host or error
  end
else unreachable
  db --> schema : Failure
  schema --> check : SchemaState(unreachable)
  check --> ready : Unhealthy
  ready --> probe : 503 Unhealthy
end
@enduml
