@startuml
title UML sequence behaviour — Trace a collection run
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx Worker application" #D1FADF
  participant "RunRecordingBehavior" as rec
  participant "RunCollectionCommandHandler" as handler
  participant "CollectionPipeline" as pipe
  participant "RunTelemetry" as tel
  participant "RunMetrics" as metrics
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "HttpSourceFetcher" as fetch
  participant "TelemetryRedactionProcessor" as red
  participant "OTLP exporter" as exp
end box
participant "Source" as src
rec -> tel : StartRun(collection): root span collection.run (L2-094)
rec -> handler : Next
alt no run to execute
  handler -> tel : Discard(): the pickup exports nothing
else the lease names a pending run
  handler -> tel : Covers(run): keryx.run.id
  handler -> pipe : ExecuteAsync(run)
  pipe -> tel : StartStage(fetch, parse, classify, deduplicate, store): open together, as they stream
  loop each source, a few at once
    pipe -> tel : StartFetch(source): source.fetch with keryx.source.id
    pipe -> fetch : FetchAsync(source)
    fetch -> src : GET
    src --> fetch : Response
    fetch --> pipe : FetchResult
    pipe -> metrics : Fetched(source, seconds)
  end
  pipe -> tel : End the five streaming stages when the stream ends
  pipe -> tel : StartStage(publish), ended after publishing
  handler -> metrics : Finished(run): seconds by outcome, added, updated, unchanged, sources failed
end
opt the run throws
  rec -> tel : Status Error, error.type; the run's correlation id is the trace id
end
rec -> red : End the root span
red -> red : Keep keryx.run.id, keryx.stage, keryx.source.id; drop every other tag
red -> exp : Export the run's trace
note over pipe : Log lines are structured: ids, counts, kinds;\nno fetched content, summary, connection string or secret
@enduml
