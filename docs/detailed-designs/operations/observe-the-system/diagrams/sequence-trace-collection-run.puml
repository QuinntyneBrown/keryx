@startuml
title UML sequence behaviour — Trace a collection run
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx Worker application" #D1FADF
  participant "CollectionPipeline" as pipe
  participant "CollectionTelemetry" as tel
  participant "CollectionMetrics" as metrics
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "HttpSourceFetcher" as fetch
  participant "TelemetryRedactionProcessor" as red
  participant "OTLP exporter" as exp
end box
participant "Source" as src
pipe -> tel : StartRun(run id) — one trace per run (L2-094)
loop each stage: fetch, parse, classify, deduplicate, store, publish
  pipe -> tel : StartStage(stage)
  opt fetch stage
    loop each source
      pipe -> tel : StartFetch(source id)
      pipe -> fetch : FetchAsync(source)
      fetch -> src : GET
      src --> fetch : Response
      fetch --> pipe : FetchResult
      pipe -> metrics : RecordFetch(source id, latency)
    end
  end
end
pipe -> metrics : RecordRun(duration, added, updated, unchanged, sources failed)
pipe -> red : End spans
red -> red : Keep keryx.source.id; drop url.full and url.query
red -> exp : Export run trace
note over pipe : Log lines are structured: ids, counts, kinds;\nno fetched content, summary, connection string or secret
@enduml
