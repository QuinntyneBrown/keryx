@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Observe the system

Container_Boundary(api, "Keryx API") {
  Component(aspnet, "ASP.NET Core instrumentation", "OpenTelemetry", "Route template, method, status, duration, client id")
  Component(apim, "ApiUsageMiddleware", "Middleware", "Tags request measurement and span with keryx.client.id")
  Component(pdm, "ProblemDetailsMapper", "Exception handler", "Adds trace_id")
}
Container_Boundary(worker, "Keryx Worker") {
  Component(colt, "RunTelemetry", "ActivitySource Keryx.Runs", "Run, stage and fetch spans; by id, never by URL")
  Component(colm, "RunMetrics", "Meter Keryx.Runs", "Run duration, items, sources failed, fetch latency, in seconds")
}
Container_Boundary(infra, "Keryx Infrastructure") {
  Component(setup, "KeryxTelemetry", "Service registration", "SDK, logging provider, optional OTLP exporter")
  Component(red, "TelemetryRedactionProcessor", "BaseProcessor<Activity>", "Allow-listed tags only")
  Component(exp, "OTLP exporter", "OpenTelemetry", "Only when an endpoint is configured")
}
System_Ext(otel, "OTLP collector", "Receives traces, metrics and logs")

Rel(aspnet, red, "Spans pass through")
Rel(colt, red, "Spans pass through")
Rel(red, exp, "Redacted spans")
Rel(apim, aspnet, "Adds the client id to")
Rel(colm, exp, "Metrics")
Rel(setup, red, "Registers")
Rel(setup, exp, "Adds when configured")
Rel(exp, otel, "Exports", "OTLP")
Rel(pdm, aspnet, "Reads current trace id from")
@enduml
