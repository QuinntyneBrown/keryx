@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Observe the system

class KeryxTelemetry <<static>> {
  +{static} ApiServiceName = "keryx-api"
  +{static} WorkerServiceName = "keryx-worker"
  +{static} AddKeryxTelemetry(services, configuration, defaultServiceName: string, configureTracing, configureMetrics): IServiceCollection
}
class TelemetryRedactionProcessor {
  -{static} FrozenSet<string> AllowedTags
  +OnEnd(activity: Activity): void
}
class RunTelemetry {
  -{static} ActivitySource Source = "Keryx.Runs"
  ~StartRun(worker: RunWorker): Activity?
  ~Covers(run: Run): void
  ~Discard(): void
  ~StartStage(run: ActivityContext, stage: PipelineStage): Activity?
  ~StartFetch(stage: ActivityContext, source: Source): Activity?
}
class RunRecordingBehavior {
  +Handle(request, next): TResponse
}
class RunMetrics {
  -Histogram<double> runDuration
  -Counter<long> items
  -Counter<long> sourcesFailed
  -Histogram<double> fetchDuration
  ~Finished(run: Run): void
  ~Fetched(source: Source, took: TimeSpan): void
}
class ApiUsageMiddleware {
  ~ClientIdTag = "keryx.client.id"
  +InvokeAsync(context: HttpContext): Task
}
class ProblemDetailsMapper {
  +Map(e: Exception, http: HttpContext): ProblemDetails
}
class "BaseProcessor<Activity>" as BP
class ApiError <<TypeScript>> {
  +code: string
  +trace_id: string
}

BP <|-- TelemetryRedactionProcessor
KeryxTelemetry ..> TelemetryRedactionProcessor : registers
KeryxTelemetry ..> RunTelemetry : registers source
RunRecordingBehavior ..> RunTelemetry : root span per run
KeryxTelemetry ..> RunMetrics : registers meter
ApiUsageMiddleware ..> IHttpMetricsTagsFeature : adds keryx.client.id
ProblemDetailsMapper ..> ApiError : trace_id read by admin app
@enduml
