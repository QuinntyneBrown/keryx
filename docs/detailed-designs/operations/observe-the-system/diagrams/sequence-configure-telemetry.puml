@startuml
title UML sequence behaviour — Configure telemetry at startup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Keryx API application" #D1FADF
  participant "API Program" as prog
end box
box "Backend — Keryx Worker application" #D1FADF
  participant "Worker Program" as wprog
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  participant "KeryxTelemetry" as setup
  participant "TelemetryRedactionProcessor" as red
  participant "OTLP exporter" as exp
end box
participant "OTLP collector" as otel
prog -> setup : AddKeryxTelemetry(services, configuration, "keryx-api")
wprog -> setup : AddKeryxTelemetry(services, configuration, "keryx-worker")
setup -> setup : Register ASP.NET Core and HttpClient instrumentation, sources, meters, logging provider
setup -> red : Register before export
alt OTEL_EXPORTER_OTLP_ENDPOINT configured
  setup -> exp : Add OTLP exporter for traces, metrics, logs
  exp -> otel : Export batches (L2-094)
else no endpoint
  setup -> setup : No exporter; process runs without error
end
@enduml
