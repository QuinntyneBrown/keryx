@startuml
title UML sequence behaviour — Record an audit entry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Keryx Admin application" #E0F2FE
  participant "ArticlesPage" as page
  participant "ArticlesApi" as client
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminArticlesController" as ctrl
  participant "HttpContextCurrentStaff" as cur
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "DecideOnArticleHandler" as h
  participant "AuditTrail" as trail
  participant "AuditEntry" as entry
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
actor -> page : Publish a held article
page -> client : Build typed request
client -> ctrl : POST publish for art_…
ctrl -> h : Send PublishArticle
h -> db : Load article
alt the status changes
  h -> trail : Record(article_published, art_…)
  trail -> cur : SubjectId
  cur --> trail : sub claim
  trail -> entry : New(subject id, article_published, art_…, now) (L2-085)
  h -> db : SaveChanges: the status and the entry in one commit
  db --> h : Committed, or neither
  h --> ctrl : Decision
  ctrl --> client : 200
else the article is missing, or the save fails
  h --> ctrl : Exception; nothing saved, no entry
  ctrl --> client : ProblemDetails
end
client --> page : Feature result
page --> actor : Present outcome
@enduml
