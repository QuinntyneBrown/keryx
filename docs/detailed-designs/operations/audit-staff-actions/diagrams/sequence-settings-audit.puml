@startuml
title UML sequence behaviour — Audit a settings save
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Keryx Admin application" #E0F2FE
  participant "SettingsPage" as page
  participant "SettingsApi" as client
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminSettingsController" as ctrl
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "UpdateSettingsHandler" as h
  participant "SettingsDiff" as diff
  participant "AuditTrail" as trail
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
actor -> page : Change alert e-mail and failure streak; Save changes
page -> client : PUT /admin/v1/settings
client -> ctrl : Request
ctrl -> h : Send UpdateSettings
h -> db : Load saved settings
db --> h : Settings
h -> diff : ChangedFields(saved, submitted)
diff --> h : ["alert_email", "alert_failure_streak"]
h -> trail : Record(settings_saved, settings, field names only) (L2-085)
h -> db : SaveChanges: settings and entry in one commit
db --> h : Committed
h --> ctrl : Saved settings
ctrl --> client : 200
client --> page : Saved
page --> actor : Confirm save
@enduml
