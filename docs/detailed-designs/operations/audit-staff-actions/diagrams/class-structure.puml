@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Audit staff actions

interface IAuditTrail {
  +Record(action: AuditAction, targetId: string, changedFields: IReadOnlyList<string>?): void
}
class AuditTrail {
  -IAppDbContext db
  -ICurrentStaff staff
  -TimeProvider time
}
class DecideOnArticleHandler {
  +Handle(PublishArticle): ArticleDecisionDto
}
class UpdateSettingsHandler {
  +Handle(UpdateSettings): SettingsDto
}
interface ICurrentStaff {
  +string SubjectId
}
class HttpContextCurrentStaff
class AuditEntry {
  +long Id
  +string SubjectId
  +AuditAction Action
  +string TargetId
  +IReadOnlyList<string> ChangedFields
  +DateTimeOffset OccurredAt
}
enum AuditAction {
  article_published
  article_hidden
  article_reverted
  source_added
  source_edited
  source_removed
  source_restored
  api_key_created
  api_key_revoked
  issue_muted
  issue_unmuted
  run_started
  run_retried
  settings_saved
}
class SettingsDiff {
  +ChangedFields(saved: SettingsValues, submitted: SettingsValues): IReadOnlyList<string>
}
class AccessRefusals {
  -Counter<long> refused
  +Record(status: int, reason: string, routeTemplate: string): void
}

AuditTrail ..|> IAuditTrail
DecideOnArticleHandler ..> IAuditTrail : records before saving
UpdateSettingsHandler ..> IAuditTrail : records before saving
AuditTrail ..> ICurrentStaff : reads
AuditTrail ..> AuditEntry : creates
AuditEntry --> AuditAction
HttpContextCurrentStaff ..|> ICurrentStaff
UpdateSettingsHandler ..> SettingsDiff : changed fields from
@enduml
