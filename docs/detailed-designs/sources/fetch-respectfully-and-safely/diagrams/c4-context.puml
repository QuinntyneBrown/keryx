@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Fetch respectfully and safely

Person(staff, "Staff member", "Curates collection through the admin app")
System(keryx, "Keryx", "Christian and fitness news aggregator")
System_Ext(sources, "Sources", "Feeds, web pages, Instagram, Eventbrite, news search")
System_Ext(otel, "OTLP collector", "Receives traces, metrics and logs")

Rel(staff, keryx, "Test-fetches sources through")
Rel(keryx, sources, "Reads robots.txt, feeds, pages and platform APIs from", "HTTPS, identified User-Agent")
Rel(keryx, otel, "Sends a span per source fetch to", "OTLP")
@enduml
