@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Edit and remove a source

Container_Boundary(admin_b, "Keryx admin application") {
  Component(edit, "EditSourceDialog", "Angular CDK Dialog component", "Edits URL, organisation and region of one source")
  Component(rm, "RemoveSourceDialog", "Angular CDK Dialog component", "Confirms removal; focus starts on Cancel")
  Component(store, "SourcesStore", "Angular signal store", "Holds the current page of sources and header counts")
  Component(svc, "HttpSourcesService", "Angular service", "Calls PUT and DELETE on a source")
}
Container_Boundary(api_b, "Keryx API") {
  Component(ctrl, "AdminSourcesController", "ASP.NET Core controller", "Exposes /admin/v1/sources/{id}")
}
Container_Boundary(app_b, "Keryx Application and Domain") {
  Component(uh, "UpdateSourceCommandHandler", "MediatR handler", "Applies the change and test-fetches the address once")
  Component(rh, "RemoveSourceCommandHandler", "MediatR handler", "Marks the source removed and keeps its records")
  Component(fetch, "ISourceFetcher", "Application contract", "Fetches one source")
}
Container_Boundary(inf_b, "Keryx Infrastructure") {
  Component(ctx, "AppDbContext", "EF Core DbContext", "Implements IAppDbContext")
}
ContainerDb(db, "Keryx database", "Relational database, EF Core", "Persists Keryx state")

Rel(edit, svc, "Saves through")
Rel(rm, svc, "Removes through")
Rel(edit, store, "Reports result to")
Rel(rm, store, "Reports result to")
Rel(svc, ctrl, "PUT and DELETE /admin/v1/sources/{id}", "JSON/HTTPS")
Rel(ctrl, uh, "Sends UpdateSourceCommand")
Rel(ctrl, rh, "Sends RemoveSourceCommand")
Rel(uh, fetch, "Tests address once through")
Rel(uh, ctx, "Persists through IAppDbContext")
Rel(rh, ctx, "Persists through IAppDbContext")
Rel(ctx, db, "Reads and writes", "EF Core")
@enduml
