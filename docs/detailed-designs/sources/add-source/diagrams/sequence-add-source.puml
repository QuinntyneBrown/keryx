@startuml
title UML sequence behaviour — Add a source
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as staff
box "Frontend — Keryx admin application" #E0F2FE
  participant "SourcesPage" as page
  participant "AddSourceDialog" as dlg
  participant "HttpSourcesService" as svc
end box
box "Backend — Keryx API application" #D1FADF
  participant "AdminSourcesController" as ctrl
end box
box "Backend — Keryx Application and Domain" #ECFDF3
  participant "CreateSourceCommandHandler" as h
  participant "OrganizationMatcher" as orgm
end box
box "Backend — Keryx Infrastructure" #FFF4E5
  database "Keryx database" as db
end box
staff -> page : Press "Add source"
page -> dlg : Open CDK Dialog (focus in URL)
staff -> dlg : Enter URL, organisation, region
dlg -> dlg : Validate entries (L2-064)
alt entries invalid
  dlg --> staff : Field messages, aria-invalid, focus first invalid field
else entries valid
  staff -> dlg : Press "Add source"
  dlg -> svc : create(source)
  svc -> ctrl : POST /admin/v1/sources
  ctrl -> ctrl : Staff policy and anti-forgery token
  ctrl -> h : Send CreateSourceCommand
  h -> h : Validate and normalize address (L2-001)
  h -> db : Find source by kind and normalized address
  db --> h : Match or none
  alt source exists
    h --> ctrl : source_exists
    ctrl --> svc : 409 ProblemDetails
    svc --> dlg : Error code
    dlg --> staff : URL field says the source is already in the list
  else new source
    h -> orgm : FindOrCreate(name, region) (L2-017)
    orgm --> h : Organization
    h -> db : Save Source in one unit of work
    db --> h : Commit result
    h --> ctrl : SourceDto
    ctrl --> svc : 201 with id src_…
    svc --> dlg : Created source
    dlg --> page : Close with result
    page --> staff : New row, focus on "Add source", "Source added" notification
  end
end
@enduml
