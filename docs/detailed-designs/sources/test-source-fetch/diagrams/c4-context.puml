@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Test a source fetch

Person(staff, "Staff member", "Curates collection through the admin app")
System(keryx, "Keryx", "Christian and fitness news aggregator")
System_Ext(sources, "Sources", "Feeds, web pages, Instagram, Eventbrite, news search")
System_Ext(idp, "Identity provider", "OpenID Connect sign-in for staff")
System_Ext(otel, "OTLP collector", "Receives traces, metrics and logs")

Rel(staff, keryx, "Asks for a test fetch of a source through")
Rel(staff, idp, "Signs in with")
Rel(keryx, sources, "Fetches the address once, storing nothing", "HTTPS")
Rel(keryx, otel, "Sends the request and fetch spans to", "OTLP")
@enduml
