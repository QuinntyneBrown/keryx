    { "fg": "--color-fg-default", "bg": "--color-bg-canvas", "min": 4.5, "note": "body text on page" },
    { "fg": "--color-fg-default", "bg": "--color-bg-surface", "min": 4.5, "note": "body text on cards, tables, inputs" },
    { "fg": "--color-fg-default", "bg": "--color-bg-surface-raised", "min": 4.5, "note": "body text in dialogs and menus" },
    { "fg": "--color-fg-default", "bg": "--color-bg-surface-sunken", "min": 4.5, "note": "text in the status card history well" },
    { "fg": "--color-fg-default", "bg": "--color-bg-subtle", "min": 4.5, "note": "text on hovered rows, checked choice card" },
    { "fg": "--color-fg-default", "bg": "--color-bg-subtle-hover", "min": 4.5, "note": "icon button glyph on its hover fill" },
    { "fg": "--color-fg-default", "bg": "--color-accent-subtle", "min": 4.5, "note": "body text on a selected row or current run" },

    { "fg": "--color-fg-muted", "bg": "--color-bg-canvas", "min": 4.5, "note": "page description, tab labels" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface", "min": 4.5, "note": "secondary text on cards and tables" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface-raised", "min": 4.5, "note": "dialog description" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface-sunken", "min": 4.5, "note": "table head, chart caption" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-subtle", "min": 4.5, "note": "neutral badge, tag, neutral alert, read-only input" },
