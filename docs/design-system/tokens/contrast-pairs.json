    { "fg": "--color-fg-muted", "bg": "--color-accent-subtle", "min": 4.5, "note": "secondary text on a selected row or current run" },

    { "fg": "--color-fg-subtle", "bg": "--color-bg-canvas", "min": 4.5, "note": "table footer, ids on page" },
